<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Prefer local artifacts first -->
    <clear />
    <add key="local-packages" value="./artifacts" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

	<packageSourceMapping>
		<!-- Only pull Injectable.* from local; everything else from nuget.org -->
		<packageSource key="local-packages">
			<package pattern="Injectable.*" />
		</packageSource>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>
</configuration>
